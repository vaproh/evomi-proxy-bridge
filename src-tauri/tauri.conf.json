{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Evomi Bridge",
  "version": "0.5.0",
  "identifier": "com.vaproh.evomibridge",
  "build": {
    "frontendDist": "../ui",
    "devUrl": null,
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Evomi Bridge",
        "width": 400,
        "height": 660,
        "minWidth": 400,
        "minHeight": 660,
        "maxWidth": 400,
        "maxHeight": 660,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "center": true,
        "skipTaskbar": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Local Evomi proxy bridge with session rotation",
    "longDescription": "Loopback HTTP proxy chaining Mullvad Browser to Evomi residential proxies with hotkey-style session rotation, PAC auto-config, and exit-IP verification."
  }
}
