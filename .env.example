# Copy to .env and fill in. Then: chmod 600 .env
# Precedence: CLI flags > this file > built-in defaults.
# Password is read from memory only; this file is the one on-disk exception,
# so keep it owner-readable-only and never commit it.

# Option A: full dashboard URL (user, password+flags, host, port, tls all in one)
# EVOMI_PROXY_URL=http://USER:BASEPASS_country-GB,US_session-Ab12Cd34_lifetime-15@core-residential.evomi.com:1000
# (also accepts Evomi's https://host:port:user:pass_flags shape; https:// enables TLS)

# Option B: individual keys (these override the URL parts above when both set)
EVOMI_USERNAME=
EVOMI_PASSWORD=
# EVOMI_UPSTREAM_HOST=rp.evomi.com
# EVOMI_UPSTREAM_PORT=1000
# EVOMI_UPSTREAM_TLS=false   # true for https endpoints (*.evomi-proxy.com:1001)
# EVOMI_LOCAL_PORT=8899
# EVOMI_LOCAL_USER=
# EVOMI_LOCAL_PASS=
# EVOMI_CONNECT_TIMEOUT=10.0
# EVOMI_MAX_CONNECTIONS=100
# EVOMI_NOTIFY=true
